// ---------------- MODULE 1: MOVIE DATABASE ----------------

class Movie
{
private:
    string name;
    string genre;
    float rating;
    int releaseYear;

public:
    Movie()
    {
        name = "";
        genre = "";
        rating = 0.0;
        releaseYear = 0;
    }

    Movie(string n, string g, float r, int y)
    {
        name = n;
        genre = g;
        rating = r;
        releaseYear = y;
    }

    string getName() const { return name; }
    string getGenre() const { return genre; }
    float getRating() const { return rating; }
    int getReleaseYear() const { return releaseYear; }
};



int loadMovies(Movie movies[])
{
    ifstream file("movies.csv");

    if (!file.is_open())
    {
        cout << "\nError: Could not open movies.csv!\n";
        cout << "Keep movies.csv in the same folder as main.cpp.\n";
        return -1;
    }

    string line;
    getline(file, line);   

    int count = 0;

    while (getline(file, line) && count < MAX_MOVIES)
    {
        if (line.empty())
        {
            continue;
        }

        stringstream ss(line);

        string name;
        string genre;
        string rating;
        string year;

        getline(ss, name, ',');
        getline(ss, genre, ',');
        getline(ss, rating, ',');
        getline(ss, year, ',');

        if (year.empty())
        {
            continue;   
        }

        movies[count] = Movie(name, genre, stof(rating), stoi(year));

        count++;
    }

    file.close();

    return count;
}
